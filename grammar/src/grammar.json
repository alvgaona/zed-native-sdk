        {
          "type": "SYMBOL",
          "name": "_tag_name"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "_tag_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "structure_tag"
        },
        {
          "type": "SYMBOL",
          "name": "element_name"
        }
      ]
    },
    "structure_tag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
