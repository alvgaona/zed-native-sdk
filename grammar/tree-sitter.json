{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "native",
      "camelcase": "Native",
      "scope": "source.native",
      "path": ".",
      "file-types": ["native"],
      "injection-regex": "^native$"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Tree-sitter grammar for Native SDK .native markup",
    "authors": [{ "name": "alvgaona", "email": "alvgaona@gmail.com" }],
    "links": {
      "repository": "https://github.com/alvgaona/zed-native-sdk"
    }
  }
}
